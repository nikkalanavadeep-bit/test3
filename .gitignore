# ==============================================================================
# Git Ignore Configuration for Gemini Chatbot & Supabase Workspace
# ==============================================================================

# 1. Environment Variables & Secret Credentials (NEVER commit to GitHub)
.env
.env.*
*.env
backend/.env
frontend/.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Preserve example configuration templates
!.env.example
!*.env.example
!backend/.env.example
!frontend/.env.example

# 2. Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
*/node_modules/
.pnp
.pnp.js

# 3. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 4. OS-Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# 5. IDE, Editor & Tool Settings
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# 6. Build Outputs & Caches
dist/
build/
out/
.cache/
.parcel-cache/
.next/
.nuxt/
.svelte-kit/
.turbo/

# 7. Temporary, Scratch & Local Runtime Files
tmp/
temp/
.tmp/
.temp/
scratch/
.agents/
*.bak
*.orig

# 8. Testing & Coverage
coverage/
.nyc_output/
